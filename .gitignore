# Publish documentation and reviewed current source only.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/code/
!/data/
!/results/
/code/*
!/code/final/
!/code/tools/
!/code/explore/
/code/explore/*
!/code/explore/github_legacy/
/code/explore/github_legacy/*
!/code/explore/github_legacy/*.py
!/code/explore/github_legacy/README.md
/code/final/**
!/code/final/**/*.py
!/code/final/**/*.md
!/code/final/**/requirements.txt
!/code/final/slides/
/code/tools/*
!/code/tools/
!/code/explore/
/code/explore/*
!/code/explore/github_legacy/
/code/explore/github_legacy/*
!/code/explore/github_legacy/*.py
!/code/explore/github_legacy/README.md*.py
/data/*
!/data/README.md
/results/*
!/results/README.md
# Never track caches, notebooks, credentials or environments.
**/__pycache__/
*.py[cod]
*.ipynb
.env
.env.*
*.pem
*.key

# Reviewed aggregate reports and their single-file generator.
!/code/reporting/
/code/reporting/*
!/code/reporting/*.py
!/reports/
/reports/*
!/reports/brain_age/
/reports/brain_age/*
!/reports/brain_age/*.md
!/reports/brain_age/*.csv
!/reports/brain_age/*.png
!/reports/brain_age/*.pdf
!/reports/brain_age/*.svg
!/reports/brain_age/*.html
!/reports/brain_age/*.json
!/reports/brain_age/slide_tables/
/reports/brain_age/slide_tables/*
!/reports/brain_age/slide_tables/*.csv

# Reviewed source-only pipeline audit and editable meeting slides.
!/reports/pipeline_audit/
/reports/pipeline_audit/*
!/reports/pipeline_audit/README.md
!/reports/pipeline_audit/build_slides.py
!/reports/pipeline_audit/requirements.txt
!/reports/pipeline_audit/audit_findings.tsv
!/reports/pipeline_audit/DWI_pipeline_audit_editable.pptx
!/reports/pipeline_audit/DWI_pipeline_audit_editable.pdf

# Unified predictive pipeline source/configuration; runtime inputs stay in results/.
!/code/run_pipeline.py
!/code/test_pipeline.py
!/code/brainage_pipeline/
/code/brainage_pipeline/**
!/code/brainage_pipeline/*.py
!/code/brainage_pipeline/README.md
!/code/brainage_pipeline/configs/
!/code/brainage_pipeline/configs/*.json

# Reviewed aggregate current reports and editable slides; no individual records.
!/reports/new_pipeline/
/reports/new_pipeline/**
!/reports/new_pipeline/**/
!/reports/new_pipeline/**/*.html
!/reports/new_pipeline/**/*.md
!/reports/new_pipeline/**/*.csv
!/reports/new_pipeline/**/*.json
!/reports/new_pipeline/**/*.png
!/reports/new_pipeline/**/*.svg
!/reports/new_pipeline/**/*.pdf
!/reports/new_pipeline/**/*.pptx
/reports/new_pipeline/**/*private*

# Published presentation exports; source data and runtime results remain local.
!/reports/brain_age/slides/
/reports/brain_age/slides/*
!/reports/brain_age/slides/*.pptx
!/reports/brain_age/slides/*.pdf
