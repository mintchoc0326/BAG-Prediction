# Publish documentation and reviewed current source only.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/code/
!/data/
!/results/
/code/*
!/code/final/
!/code/tools/
!/code/explore/
/code/explore/*
!/code/explore/github_legacy/
/code/explore/github_legacy/*
!/code/explore/github_legacy/*.py
!/code/explore/github_legacy/README.md
/code/final/**
!/code/final/**/*.py
!/code/final/**/*.md
!/code/final/**/requirements.txt
!/code/final/slides/
/code/tools/*
!/code/tools/
!/code/explore/
/code/explore/*
!/code/explore/github_legacy/
/code/explore/github_legacy/*
!/code/explore/github_legacy/*.py
!/code/explore/github_legacy/README.md*.py
/data/*
!/data/README.md
/results/*
!/results/README.md
# Never track caches, notebooks, credentials or environments.
**/__pycache__/
*.py[cod]
*.ipynb
.env
.env.*
*.pem
*.key
